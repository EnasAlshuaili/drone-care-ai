# Copy this file to .env and fill in real values for local development.
# Never commit the resulting .env file.

# --- General ---
ENVIRONMENT=development

# --- Frontend / Backend URLs (used by the frontend API client and CORS) ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Used directly by docker-compose and, once the database phase is
# implemented, by the backend's SQLAlchemy engine.
POSTGRES_USER=dronecare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dronecare
DATABASE_URL=postgresql://dronecare:change-me@db:5432/dronecare

# --- Authentication (JWT) ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- ML artifacts ---
# Independently configurable so the served model/scaler/encoder set can be
# swapped (e.g. production vs. corrected-pipeline artifacts) without code
# changes. Paths are relative to the backend working directory.
ML_MODEL_PATH=../ann2_model.h5
ML_SCALER_PATH=../scaler2.pkl
ML_ENCODERS_PATH=../encoders.pkl
